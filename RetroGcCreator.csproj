<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>Src\app.manifest</ApplicationManifest>
        <AssemblyName>retrogc-creator</AssemblyName>
        <RootNamespace>RetroGcCreator</RootNamespace>
        <!-- Overridden at publish time (release.yml: -p:Version=X.Y.Z) -->
        <Version>0.0.0</Version>
        <ApplicationIcon>Src\Assets\Icons\launcher.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Joveler.Compression.XZ" Version="5.0.2" />
    </ItemGroup>

    <!--
        ScreenScraper developer login, built into the app (never committed): from the SCREENSCRAPER_DEVID /
        SCREENSCRAPER_DEVPASSWORD environment variables (GitHub secrets in release.yml), or
        -p:SsDevId=... -p:SsDevPassword=... Empty when unset: the login can then be typed in the app.
    -->
    <PropertyGroup>
        <SsDevId Condition="'$(SsDevId)' == ''">$(SCREENSCRAPER_DEVID)</SsDevId>
        <SsDevPassword Condition="'$(SsDevPassword)' == ''">$(SCREENSCRAPER_DEVPASSWORD)</SsDevPassword>
    </PropertyGroup>

    <UsingTask TaskName="WriteScreenScraperDev" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Id ParameterType="System.String" />
            <Password ParameterType="System.String" />
            <File ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var key = new byte[] { 0x5A, 0xC3, 0x17, 0x9E, 0x21, 0x6B, 0xF4, 0x08, 0xB2, 0x4D, 0x93, 0x3E };
                Func<string, string> encode = value =>
                {
                    var bytes = Encoding.UTF8.GetBytes(value ?? string.Empty);
                    return string.Join(", ", bytes.Select((b, i) => "0x" + ((byte)(b ^ key[i % key.Length])).ToString("X2")));
                };
                var text = "// <auto-generated>Written at build time by RetroGcCreator.csproj. Do not commit.</auto-generated>\n" +
                           "namespace RetroGcCreator.Services.ScreenScraper;\n\n" +
                           "internal static partial class ScreenScraperDev\n{\n" +
                           "    private static readonly byte[] Key = [" + string.Join(", ", key.Select(b => "0x" + b.ToString("X2"))) + "];\n" +
                           "    private static readonly byte[] IdData = [" + encode(Id) + "];\n" +
                           "    private static readonly byte[] PasswordData = [" + encode(Password) + "];\n}\n";
                Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(File)));
                // Only rewritten when it changes: keeps incremental builds incremental.
                if (!System.IO.File.Exists(File) || System.IO.File.ReadAllText(File) != text)
                    System.IO.File.WriteAllText(File, text);
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="GenerateScreenScraperDev" BeforeTargets="CoreCompile;BeforeBuild">
        <PropertyGroup>
            <!-- IntermediateOutputPath is only known once the SDK targets are imported: set here. -->
            <SsDevFile>$(IntermediateOutputPath)ScreenScraperDev.g.cs</SsDevFile>
        </PropertyGroup>
        <WriteScreenScraperDev Id="$(SsDevId)" Password="$(SsDevPassword)" File="$(SsDevFile)" />
        <ItemGroup>
            <Compile Remove="$(SsDevFile)" />
            <Compile Include="$(SsDevFile)" />
            <FileWrites Include="$(SsDevFile)" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Remove="Src\Assets\**" />
        <AvaloniaResource Include="Src\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
