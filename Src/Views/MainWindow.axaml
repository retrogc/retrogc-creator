<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:RetroGcCreator.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RetroGcCreator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="RetroGcCreator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Icons/launcher.ico"
        Width="1280" Height="840"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Section colours: General (cyan), RetroArch (magenta), MiSTer (violet); folders in yellow -->
        <StaticResource x:Key="GeneralBrush" ResourceKey="CyanBrush" />
        <StaticResource x:Key="RetroArchBrush" ResourceKey="MagentaBrush" />
        <StaticResource x:Key="MisterBrush" ResourceKey="VioletBrush" />
        <StaticResource x:Key="AmberBrush" ResourceKey="YellowBrush" />
    </Window.Resources>

    <!-- Compact density: scoped to the main window so the dialogs keep their own look. -->
    <Window.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="(v:PixelPerfect.FontSize)" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="(v:PixelPerfect.FontSize)" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.sectionhint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Section cards: flat, border in the section colour, hard pixel shadow -->
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BoxShadow" Value="4 4 0 0 #000000" />
        </Style>
        <Style Selector="Border.card.general">
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        </Style>
        <Style Selector="Border.card.retroarch">
            <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
        </Style>
        <Style Selector="Border.card.mister">
            <Setter Property="BorderBrush" Value="{StaticResource VioletBrush}" />
        </Style>

        <!-- Square icon badge in front of a section title: filled with the section colour -->
        <Style Selector="Border.badge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        </Style>
        <Style Selector="Border.badge.general">
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
        </Style>
        <Style Selector="Border.badge.retroarch">
            <Setter Property="Background" Value="{StaticResource MagentaBrush}" />
        </Style>
        <Style Selector="Border.badge.mister">
            <Setter Property="Background" Value="{StaticResource VioletBrush}" />
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Inter, Arial, sans-serif" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        </Style>
        <Style Selector="TextBox.path">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="(v:PixelPerfect.FontSize)" Value="8" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Button.small PathIcon">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="Button.small /template/ ContentPresenter#PART_ContentPresenter, Button.icon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="2 2 0 0 #000000" />
        </Style>
        <Style Selector="Button.small:pressed, Button.icon:pressed">
            <Setter Property="RenderTransform" Value="translate(2px,2px)" />
        </Style>
        <!-- Square icon button used in path rows -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="Button.icon.arrow PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button:disabled PathIcon">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- Path / check state icons -->
        <Style Selector="PathIcon.state">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        </Style>
        <Style Selector="PathIcon.state.ok">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="PathIcon.state.bad">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="PathIcon.listicon">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        </Style>

        <!-- Status bar -->
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="Rectangle.led.error">
            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="Rectangle.led.busy">
            <Setter Property="Fill" Value="{StaticResource InfoBrush}" />
        </Style>

        <!-- Banners -->
        <Style Selector="Border.banner">
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="Border.banner TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.banner PathIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- One path: status icon, editable relative path, file picker, list controls -->
        <DataTemplate DataType="vm:PathEntryViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="3" Margin="0,0,0,4">
                <PathIcon Classes="state ok" Data="{StaticResource IconCheck}" IsVisible="{Binding IsPresent}"
                          ToolTip.Tip="{Binding StatusText}" Margin="0,0,3,0" />
                <PathIcon Classes="state bad" Data="{StaticResource IconWarning}"
                          IsVisible="{Binding !IsPresent}" ToolTip.Tip="{Binding StatusText}" Margin="0,0,3,0" />
                <TextBox Grid.Column="1" Classes="path" Text="{Binding Path}"
                         PlaceholderText="relative/path/in/the/card" ToolTip.Tip="{Binding StatusText}" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding BrowseCommand}" Margin="1,0,0,0"
                        ToolTip.Tip="Choose a file: it is copied into the card">
                    <PathIcon Data="{StaticResource IconFolderOpen}" Foreground="{StaticResource AmberBrush}" />
                </Button>
                <Button Grid.Column="3" Classes="icon arrow ghost" Command="{Binding MoveUpCommand}"
                        IsVisible="{Binding Owner, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Move up">
                    <PathIcon Data="{StaticResource IconUp}" />
                </Button>
                <Button Grid.Column="4" Classes="icon arrow ghost" Command="{Binding MoveDownCommand}"
                        IsVisible="{Binding Owner, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Move down">
                    <PathIcon Data="{StaticResource IconDown}" />
                </Button>
                <Button Grid.Column="5" Classes="icon ghost danger" Command="{Binding RemoveCommand}"
                        IsVisible="{Binding Owner, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Remove from the list (the file stays in the folder)">
                    <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- A list of paths (roms, runtimes): one header line, then the rows -->
        <DataTemplate DataType="vm:PathListViewModel">
            <StackPanel Spacing="3">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Panel VerticalAlignment="Center">
                        <PathIcon Classes="listicon" Data="{StaticResource IconSdCard}" IsVisible="{Binding !IsRuntime}" />
                        <PathIcon Classes="listicon" Data="{StaticResource IconWrench}" IsVisible="{Binding IsRuntime}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="field" Margin="0" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Hint}" />
                    <TextBlock Grid.Column="2" Text="— none" Classes="sectionhint" IsVisible="{Binding IsEmpty}" />
                    <Button Grid.Column="3" Classes="small ghost" Command="{Binding AddPathCommand}"
                            ToolTip.Tip="Add an empty line to type a path">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource IconAdd}" />
                            <TextBlock Text="Path" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="small" Command="{Binding AddFilesCommand}" ToolTip.Tip="{Binding Hint}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource IconAdd}" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Files…" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}" />
            </StackPanel>
        </DataTemplate>

        <!-- Checklist line: icon, label, path (one line) -->
        <DataTemplate DataType="vm:FileCheck">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,0,0,3" ToolTip.Tip="{Binding Path}">
                <PathIcon Classes="state ok" Data="{StaticResource IconCheck}" IsVisible="{Binding IsPresent}" />
                <PathIcon Classes="state bad" Data="{StaticResource IconWarning}" IsVisible="{Binding IsProblem}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Path}" Classes="mono" FontSize="15" Opacity="0.8"
                           TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===================================================== Toolbar -->
        <Panel>
            <Border Padding="12,8,12,10" Background="{StaticResource SurfaceSunkenBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock VerticalAlignment="Center" Margin="4,0,8,0" FontFamily="{StaticResource PixelFont}"
                               v:PixelPerfect.FontSize="12">
                        <Run Text="CARD " Foreground="{StaticResource MagentaBrush}" />
                        <Run Text="CREATOR" Foreground="{StaticResource CyanBrush}" />
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" Margin="4,0,0,0" VerticalAlignment="Center"
                                ClipToBounds="True">
                        <Button Classes="tool ghost" Command="{Binding NewCardCommand}" ToolTip.Tip="Create a card in a new folder">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconSdCard}" Foreground="{StaticResource GeneralBrush}" />
                                <TextBlock Text="New" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool ghost" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open a card folder (with its .rgc)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconFolderOpen}" Foreground="{StaticResource AmberBrush}" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool ghost" Command="{Binding OpenImageCommand}" ToolTip.Tip="Open a card image (.img.xz): view it or extract it">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconDisc}" Foreground="{StaticResource MisterBrush}" />
                                <TextBlock Text="Open image" />
                            </StackPanel>
                        </Button>
                        <Border Width="2" Margin="8,4" Background="{StaticResource BorderBrush}" />
                        <Button Classes="tool ghost" Command="{Binding SaveCommand}" HotKey="Ctrl+S" ToolTip.Tip="Save the .rgc (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconSave}" Foreground="{StaticResource GeneralBrush}" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool ghost" Command="{Binding DuplicateCommand}"
                                ToolTip.Tip="Copy this card into a new folder and open the copy">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconCopy}" Foreground="{StaticResource RetroArchBrush}" />
                                <TextBlock Text="Duplicate…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="tool" Command="{Binding FlashCommand}" ToolTip.Tip="Build the image if needed, then write it to a USB stick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconUsb}" Foreground="{StaticResource RetroArchBrush}" />
                                <TextBlock Text="Write to USB" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool primary" Command="{Binding BuildCommand}" Padding="14,5"
                                ToolTip.Tip="Save, then build the .img.xz card image">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconArchive}" Foreground="{StaticResource TextOnAccentBrush}" />
                                <TextBlock Text="Build image" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Rainbow stripe under the toolbar -->
            <UniformGrid Classes="stripe" VerticalAlignment="Bottom">
                <Rectangle Fill="{StaticResource MagentaBrush}" />
                <Rectangle Fill="{StaticResource OrangeBrush}" />
                <Rectangle Fill="{StaticResource YellowBrush}" />
                <Rectangle Fill="{StaticResource GreenBrush}" />
                <Rectangle Fill="{StaticResource CyanBrush}" />
                <Rectangle Fill="{StaticResource VioletBrush}" />
            </UniformGrid>
        </Panel>

        <!-- ===================================================== Empty state -->
        <StackPanel Grid.Row="1" IsVisible="{Binding !HasCard}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="14" MaxWidth="520">
            <Border Width="124" Height="124" HorizontalAlignment="Center" Padding="8"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="2"
                    BoxShadow="6 6 0 0 #000000" Margin="0,0,0,8">
                <Image Source="/Assets/Icons/retrogc.png" Width="104" Height="104" />
            </Border>
            <TextBlock Text="Make a game card" Classes="h1" HorizontalAlignment="Center"
                       Foreground="{StaticResource YellowBrush}" />
            <TextBlock Classes="body" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Open a card folder to edit it (every field is filled from its .rgc), open a card image (.img.xz) to view or extract it, or start a new card in an empty folder. Add the game files, then build the image and write it to a USB stick." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Classes="primary" Command="{Binding NewCardCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconSdCard}" Width="14" Height="14" Foreground="{StaticResource TextOnAccentBrush}" />
                        <TextBlock Text="New card" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFolderOpen}" Width="14" Height="14" Foreground="{StaticResource AmberBrush}" />
                        <TextBlock Text="Open card folder" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenImageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconDisc}" Width="14" Height="14" Foreground="{StaticResource MisterBrush}" />
                        <TextBlock Text="Open card image" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ===================================================== Card -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*" IsVisible="{Binding HasCard}">

            <!-- Sidebar: cover, folder, checklist -->
            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,2,0" Background="{StaticResource SurfaceSunkenBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12" Spacing="10">
                        <!-- Square, like the launcher cover frame (sidebar 250 - margins) -->
                        <Border Height="222" Background="{StaticResource BgBrush}" Margin="0,0,4,4"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="2" BoxShadow="4 4 0 0 #000000">
                            <Border ClipToBounds="True">
                                <Panel>
                                    <Image Source="{Binding Cover}" Stretch="Uniform" IsVisible="{Binding HasCover}" />
                                    <StackPanel IsVisible="{Binding !HasCover}" VerticalAlignment="Center" Spacing="6">
                                        <PathIcon Data="{StaticResource IconImage}" Width="32" Height="32"
                                                  Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="No cover image" Classes="hint" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Border>
                        <StackPanel IsEnabled="{Binding IsEditable}">
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,3">
                                <PathIcon Classes="listicon" Data="{StaticResource IconImage}" />
                                <TextBlock Text="COVER IMAGE (PNG)" Classes="field" Margin="0" />
                            </StackPanel>
                            <ContentControl Content="{Binding Editor.Image}" />
                        </StackPanel>

                        <Border Classes="banner warning" IsVisible="{Binding IsReadOnly}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconInfo}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="Viewing a card image: changes can't be saved. Extract it to edit and rebuild it." />
                                </Grid>
                                <Button Classes="primary small" Content="Extract…" Command="{Binding ExtractCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Classes="divider" />

                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13"
                                          Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CardFolderName}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextStrongBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CardRoot}" />
                                <Button Grid.Column="2" Classes="icon ghost" Command="{Binding OpenCardFolderCommand}"
                                        ToolTip.Tip="Show in file manager">
                                    <PathIcon Data="{StaticResource IconFolderOpen}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding CardRoot}" Classes="mono" FontSize="15" TextWrapping="Wrap" Opacity="0.8" />
                            <TextBlock Text="{Binding DefinitionName}" Classes="mono" FontSize="15" Opacity="0.8" />
                        </StackPanel>

                        <Border Classes="divider" />

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="FILES" Classes="label" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon ghost" Command="{Binding ReloadFilesCommand}"
                                        ToolTip.Tip="Reload the cover and re-check the card's files (after changing them on disk)">
                                    <PathIcon Data="{StaticResource IconRefresh}" Foreground="{StaticResource AccentBrush}" />
                                </Button>
                            </Grid>
                            <Border Classes="banner ok" IsVisible="{Binding !HasProblems}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconCheck}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChecksSummary}" />
                                </Grid>
                            </Border>
                            <Border Classes="banner warning" IsVisible="{Binding HasProblems}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconWarning}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChecksSummary}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Checks}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Editor: General on top, RetroArch | MiSTer side by side -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="14" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="14"
                      IsEnabled="{Binding IsEditable}">

                    <!-- General -->
                    <Border Grid.ColumnSpan="2" Classes="card general">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" MinHeight="26">
                                <Border Classes="badge general">
                                    <PathIcon Data="{StaticResource IconGamepad}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="General" Classes="section" />
                                <TextBlock Grid.Column="2" Classes="sectionhint" Text="Shown on the launcher screen. Only the name is required." />
                                <Button Grid.Column="3" Classes="small" Command="{Binding ScrapeCommand}"
                                        ToolTip.Tip="Fill these fields and the cover from ScreenScraper (by ROM or by name)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource IconSearch}" Foreground="{StaticResource GeneralBrush}" />
                                        <TextBlock Text="ScreenScraper…" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="NAME *" Classes="field" />
                                            <TextBox Text="{Binding Editor.Name}" PlaceholderText="Super Mario Bros" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PLATFORM" Classes="field" />
                                            <TextBox Text="{Binding Editor.Platform}" PlaceholderText="NES, CPS-1, NEOGEO…" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,2*,2*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="YEAR" Classes="field" />
                                            <TextBox Text="{Binding Editor.Year}" PlaceholderText="1989" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="DEVELOPER" Classes="field" />
                                            <TextBox Text="{Binding Editor.Developer}" PlaceholderText="Capcom" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="GENRE" Classes="field" />
                                            <TextBox Text="{Binding Editor.Genre}" PlaceholderText="Beat 'em up" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="PLAYERS" Classes="field" />
                                            <TextBox Text="{Binding Editor.Players}" PlaceholderText="1-2" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="DESCRIPTION" Classes="field" />
                                    <TextBox Text="{Binding Editor.Description}" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" MaxHeight="160"
                                             PlaceholderText="A few lines about the game" />
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RetroArch -->
                    <Border Grid.Row="1" Classes="card retroarch" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" MinHeight="26">
                                <Border Classes="badge retroarch">
                                    <PathIcon Data="{StaticResource IconMonitor}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="RetroArch" Classes="section" />
                                <TextBlock Grid.Column="2" Classes="sectionhint"
                                           Text="Windows, Linux and Recalbox. Paths are relative to the card folder."
                                           ToolTip.Tip="How Windows, Linux and Recalbox start the game. Paths are relative to the card folder." />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="CORE *" Classes="field" />
                                    <TextBox Text="{Binding Editor.Core}" PlaceholderText="nestopia, fbneo…"
                                             ToolTip.Tip="Libretro core name without _libretro suffix" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="RECALBOX SYSTEM" Classes="field" />
                                    <TextBox Text="{Binding Editor.System}" PlaceholderText="nes, fbneo, psx…"
                                             ToolTip.Tip="Recalbox system name (its ROM folder name). Recommended: lets Recalbox start the game with its own launcher." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VERSION *" Classes="field" />
                                    <TextBox Text="{Binding Editor.Version}" PlaceholderText="1.22.2"
                                             ToolTip.Tip="RetroArch version" />
                                </StackPanel>
                            </Grid>
                            <ContentControl Content="{Binding Editor.RetroArchRoms}" />
                            <ContentControl Content="{Binding Editor.RetroArchRuntimes}" />
                        </StackPanel>
                    </Border>

                    <!-- MiSTer -->
                    <Border Grid.Row="1" Grid.Column="1" Classes="card mister" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10" MinHeight="26">
                                <Border Classes="badge mister">
                                    <PathIcon Data="{StaticResource IconChip}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="MiSTer FPGA" Classes="section" />
                                <TextBlock Grid.Column="2" Classes="sectionhint" Text="Recommended"
                                           ToolTip.Tip="Recommended. Paths are relative to the card folder, which becomes the SD/USB root (_Console, _Arcade…)." />
                                <Button Grid.Column="3" Classes="small ghost" Command="{Binding Editor.CopyRetroArchRomsCommand}"
                                        IsVisible="{Binding Editor.HasMister}"
                                        ToolTip.Tip="Copy the RetroArch ROM list into the MiSTer ROM list">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource IconCopy}" Foreground="{StaticResource RetroArchBrush}" />
                                        <TextBlock Text="Use RetroArch ROMs" />
                                    </StackPanel>
                                </Button>
                                <ToggleSwitch Grid.Column="4" IsChecked="{Binding Editor.HasMister}" OnContent="" OffContent=""
                                              VerticalAlignment="Center" Margin="0,-6"
                                              ToolTip.Tip="The card supports MiSTer FPGA" />
                            </Grid>
                            <StackPanel Spacing="8" IsVisible="{Binding Editor.HasMister}">
                                <StackPanel>
                                    <TextBlock Text="CORE (.rbf) *" Classes="field" />
                                    <ContentControl Content="{Binding Editor.MisterCore}" />
                                </StackPanel>
                                <ContentControl Content="{Binding Editor.MisterRoms}" />
                                <ContentControl Content="{Binding Editor.MisterRuntimes}" />
                                <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="8"
                                      ToolTip.Tip="Delay, index and type go into the generated .mgl and only matter for non-.mra ROMs.">
                                    <StackPanel>
                                        <TextBlock Text="DELAY" Classes="field" />
                                        <TextBox Text="{Binding Editor.MisterDelay}" PlaceholderText="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="INDEX" Classes="field" />
                                        <TextBox Text="{Binding Editor.MisterIndex}" PlaceholderText="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TYPE" Classes="field" />
                                        <TextBox Text="{Binding Editor.MisterType}" PlaceholderText="f (file) or s (stream)" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <TextBlock Classes="hint" FontSize="11" IsVisible="{Binding !Editor.HasMister}"
                                       Text="Disabled: turn it on to add a MiSTer core and ROMs." />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ===================================================== Status bar -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,2,0,0" Padding="12,4"
                Background="{StaticResource SurfaceSunkenBrush}" MinHeight="32">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Rectangle Classes="led" Classes.error="{Binding StatusIsError}" Classes.busy="{Binding IsBusy}"
                         Classes.pulse="{Binding IsBusy}" Width="8" Height="8" />
                <TextBlock Grid.Column="1" Classes="status" Classes.error="{Binding StatusIsError}" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11.5"
                           IsVisible="{Binding !IsBusy}" ToolTip.Tip="{Binding StatusMessage}" />
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsBusy}">
                    <TextBlock Text="{Binding BusyStatus}" VerticalAlignment="Center" FontSize="11.5" />
                    <ProgressBar Grid.Column="1" Classes="large" Minimum="0" Maximum="100" Value="{Binding BusyPercent}"
                                 VerticalAlignment="Center" Height="14" MinHeight="14" Padding="2" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Content="Cancel" Command="{Binding CancelBusyCommand}" IsVisible="{Binding IsBusy}" />
                    <Button Classes="small ghost" Command="{Binding ShowImageCommand}"
                            IsVisible="{Binding LastImage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource IconFolderOpen}" Foreground="{StaticResource AmberBrush}" />
                            <TextBlock Text="Show image" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
